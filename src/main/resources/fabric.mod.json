{
  "schemaVersion": 1,
  "id": "shieldfixes",
  "version": "${version}",
  "name": "Shield Fixes",
  "description": "Resolves issues with shield sounds and corrects the animation glitch where the player's shield doesn't display blocking properly",
  "authors": [
    "Walksy"
  ],
  "contact": {
    "issues": "https://github.com/Walksy/ShieldFixes/issues",
    "sources": "https://github.com/Walksy/ShieldFixes",
    "homepage": "https://discord.com/invite/zeu7uNuBWY"
  },
  "license": "MIT",
  "icon": "assets/walksy/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "walksy.shieldfixes.ShieldFixes"
    ],
    "walksylib": [
      "walksy.shieldfixes.config.ShieldFixesConfig"
    ]
  },
  "mixins": [
    "shieldfixes.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "walksylib": ">=2.0.0"
  }
}